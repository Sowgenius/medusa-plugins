{
  "name": "@medusa-plugins/medusa-plugins",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && lerna clean -y",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "release": "lerna publish",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lerna": "^8.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.2",
    "tslint": "~6.1.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
