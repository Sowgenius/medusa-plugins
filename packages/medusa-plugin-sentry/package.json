{
  "name": "medusa-plugin-sentry",
  "version": "1.5.0",
  "description": "Sentry plugin for medusajs",
  "keywords": [
    "analytics",
    "sentry",
    "medusa",
    "medusajs",
    "e-commerce",
    "error-management",
    "medusa-plugins",
    "medusa-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien2p/medusa-plugins.git"
  },
  "author": "Adrien de Peretti <adrien.deperetti@gmail.com",
  "files": "[\"dist/**/*.js\", \"dist/**/*.d.ts\"]",
  "scripts": {
    "build": "tsc",
    "build:tsc": "tsc -b",
    "clean": "rimraf api services utils types coverage tsconfig.tsbuildinfo",
    "test": "jest",
    "test:ci": "yarn add -D @medusajs/medusa@${MEDUSAJS_VERSION} && yarn run test",
    "watch": "tsc --watch",
    "prepare": "cross-env NODE_ENV=production npm run build",
    "build-and-test": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@medusajs/medusa": "^2.5.1",
    "medusa-core-utils": "^1.2.0",
    "medusa-interfaces": "^1.3.7"
  },
  "devDependencies": {
    "@medusajs/medusa": "^2.5.1",
    "@medusajs/types": "^2.5.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.6",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "medusa-core-utils": "^1.2.3",
    "medusa-interfaces": "^1.3.10",
    "medusa-test-utils": "^1.1.45",
    "ts-jest": "^29.2.6",
    "ts-node": "^8.10.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@sentry/node": "^9.3.0",
    "@sentry/tracing": "^7.120.3",
    "axios": "^1.8.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testTimeout": 100000,
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transformIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/__*__/*.(t|j)s"
    ],
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "coverageDirectory": "<rootDir>/../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../setup-tests.js"
    ]
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
